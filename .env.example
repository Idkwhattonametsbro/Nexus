# Nexus Autonomous Workspace - Environment Variables
# Copy this file to .env and fill in your keys for local execution.
# On GitHub, add the same keys as repository secrets instead.
#
# ZERO-COST stack (recommended, no credit card):
#   GEMINI_API_KEY      -> Google AI Studio (aistudio.google.com), free tier,
#                          gemini-2.5-flash, ~250 req/day, vision-capable
#   GROQ_API_KEY        -> console.groq.com, free tier, gpt-oss-120b / llama-3.3-70b
#   GITHUB_MODELS_TOKEN -> any GitHub PAT, models.inference.ai.azure.com,
#                          free GPT-4.1-mini / o4-mini / gpt-5 etc.
#   CEREBRAS_API_KEY    -> cloud.cerebras.ai, free tier, llama-3.3-70b
#
# Paid/optional upgrades:
#   DEEPSEEK_API_KEY    -> platform.deepseek.com (deepseek-v4-pro)
#   OPENROUTER_API_KEY  -> openrouter.ai (claude-sonnet-4.6, etc.)
#   OPENAI_API_KEY      -> platform.openai.com (gpt-4o-mini)
#   TAVILY_API_KEY      -> app.tavily.com (live research)
#   NEXUS_GITHUB_TOKEN  -> fine-grained PAT (repo creation tool)

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GITHUB_MODELS_TOKEN=
TAVILY_API_KEY=

# Optional model overrides (defaults are current-generation, verified Aug 2026)
# NEXUS_MODEL_DEEPSEEK=deepseek-v4-pro
# NEXUS_MODEL_GEMINI=gemini-2.5-flash
# NEXUS_MODEL_GROQ=openai/gpt-oss-120b
# NEXUS_MODEL_CEREBRAS=llama-3.3-70b
# NEXUS_MODEL_OPENROUTER=anthropic/claude-sonnet-4.6
# NEXUS_MODEL_OPENAI=gpt-4o-mini
# NEXUS_MODEL_GITHUB=gpt-4.1-mini

# Set to 0 to disable the quality review pass
# NEXUS_REVIEW=1

# ---- Remote control (Telegram bot / webhook bridge) ----
# Fine-grained GitHub token scoped to the Nexus repo with Actions read/write.
NEXUS_GITHUB_TOKEN=
NEXUS_REPO=Idkwhattonametsbro/Nexus

# Telegram: get a token from @BotFather, then allowlist your numeric user id.
# Find your id by messaging @userinfobot once.
TELEGRAM_BOT_TOKEN=
NEXUS_ALLOWED_USERS=

# Link prefix for generated apps (your GitHub Pages root).
NEXUS_PAGES_ROOT=https://idkwhattonametsbro.github.io/Nexus

# Webhook bridge: optional bearer token and port.
# NEXUS_BRIDGE_TOKEN=
# NEXUS_BRIDGE_PORT=8787
