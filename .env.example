# Nexus Autonomous Workspace - Environment Variables
# Copy this file to .env and fill in your keys for local execution.
# On GitHub, add the same keys as repository secrets instead.
#
# Only DEEPSEEK_API_KEY is required for code generation. All others
# upgrade the swarm: Groq accelerates reflection, OpenRouter provides
# Claude-level routing, OpenAI is an extra fallback, Tavily enables
# live research.

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Optional model overrides (defaults are current-generation, verified Aug 2026)
# NEXUS_MODEL_DEEPSEEK=deepseek-v4-pro
# NEXUS_MODEL_GROQ=openai/gpt-oss-120b
# NEXUS_MODEL_OPENROUTER=anthropic/claude-sonnet-4.6
# NEXUS_MODEL_OPENAI=gpt-4o-mini

# Set to 0 to disable the quality review pass
# NEXUS_REVIEW=1
